<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Estado de conexión -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Estado: Desconectado"
        android:textAlignment="center"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#D32F2F"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btn_connect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Conectar USB"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Controles -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@+id/btn_connect">

        <Button
            android:id="@+id/btn_pan_180"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Girar PAN a 180°"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btn_tilt_35"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Mover TILT a 35°"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btn_reset_00"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="RESET (0, 0)"
            android:backgroundTint="#FF9800"/>
    </LinearLayout>

    <!-- Consola de logs -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Consola de comandos:"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toTopOf="@+id/scroll_logs"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- AÑADIDO: layout_marginBottom="60dp" para subirlo -->
    <ScrollView
        android:id="@+id/scroll_logs"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="#E0E0E0"
        android:padding="8dp"
        android:layout_marginBottom="60dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:id="@+id/tv_logs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:text="Esperando conexión..." />
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>