<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Estado de conexión -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Estado: Desconectado"
        android:textAlignment="center"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#D32F2F"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.05"
        app:layout_constraintBottom_toTopOf="@+id/btn_connect"/>

    <Button
        android:id="@+id/btn_connect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Conectar USB"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- CONTROLES SLIDER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@+id/btn_connect">

        <!-- PAN CONTROL -->
        <TextView
            android:id="@+id/tv_pan_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PAN: 0°"
            android:textStyle="bold"
            android:textSize="16sp"/>

        <!-- Max = 360 para ir de -180 a 180 -->
        <SeekBar
            android:id="@+id/seek_pan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="360"
            android:progress="180"
            android:layout_marginBottom="24dp"/>

        <!-- TILT CONTROL -->
        <TextView
            android:id="@+id/tv_tilt_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TILT: 0°"
            android:textStyle="bold"
            android:textSize="16sp"/>

        <!-- Max = 120 para ir de -30 a 90 -->
        <SeekBar
            android:id="@+id/seek_tilt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="120"
            android:progress="30"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btn_center"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Centrar Cámara (0,0)"
            android:backgroundTint="#FF9800"
            android:layout_marginTop="16dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>