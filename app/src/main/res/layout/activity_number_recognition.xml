<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".NumberRecognitionActivity">

    <!-- 1. CÁMARA -->
    <androidx.camera.view.PreviewView
        android:id="@+id/tflite_preview_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2. CUADRO FLOTANTE
         Agregamos constraints al inicio (start) y arriba (top) del padre.
         Esto fija su posición base en (0,0), permitiendo que setTranslationX/Y funcione perfecto.
    -->
    <View
        android:id="@+id/reticle_view"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:background="@drawable/bg_reticle"
        android:visibility="invisible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

    <!-- 3. TEXTO FLOTANTE
         Igual que el cuadro, lo anclamos a (0,0).
         Agregamos tools:ignore="HardcodedText" para quitar la advertencia amarilla.
    -->
    <TextView
        android:id="@+id/tv_prediction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#CC000000"
        android:padding="4dp"
        android:text="---"
        android:textColor="#00FF00"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="invisible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="HardcodedText"
        tools:visibility="visible" />

    <!-- 4. Texto informativo fijo -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:background="#40000000"
        android:padding="8dp"
        android:text="Detectando números..."
        android:textColor="#FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="HardcodedText" />

</androidx.constraintlayout.widget.ConstraintLayout>